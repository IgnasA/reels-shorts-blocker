{
  "manifest_version": 3,
  "name": "Reels & Shorts Blocker",
  "version": "1.0.0",
  "description": "Hides YouTube Shorts and Facebook Reels, and opens Shorts in the normal video player.",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Reels & Shorts Blocker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "css": ["content/youtube.css"],
      "js": ["settings.js", "urls.js", "content/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.facebook.com/*"],
      "css": ["content/facebook.css"],
      "js": ["settings.js", "urls.js", "content/facebook.js"],
      "run_at": "document_start"
    }
  ]
}
